{#- =====================================================================
  D0_Switch_Base | Day 0 / PnP onboarding | Jinja2
  Target  : Catalyst 9200 / 9300 / 9400 (IOS-XE) access or distribution
  Purpose : The minimum needed to put the switch on its permanent
            management address. Nothing more.

  NOT in this template, on purpose: AAA, NTP, DNS servers, syslog,
  SNMP, device credentials. Set those in Design > Network Settings and
  let Catalyst Center push them at provisioning. If you put them here
  too, you get duplicate config and compliance drift.

  Variables (Template Hub form):
    hostname          string   required
    mgmt_vlan         integer  required   e.g. 99
    mgmt_vlan_name    string   optional   default MGMT
    mgmt_ip           string   required   e.g. 10.10.99.21
    mgmt_mask         string   required   e.g. 255.255.255.0
    mgmt_gateway      string   required   e.g. 10.10.99.1
    uplink_ports      string   required   comma separated, e.g.
                                          TenGigabitEthernet1/1/1,TenGigabitEthernet1/1/2
    native_vlan       integer  optional   default 1
    allowed_vlans     string   optional   default "all"; else e.g. 10,20,99
    domain_name       string   optional
    l3_switch         boolean  optional   default false (true = ip routing + static default route)
===================================================================== -#}
hostname {{ hostname }}
!
{%- if domain_name %}
ip domain name {{ domain_name }}
{%- endif %}
!
vtp mode transparent
!
vlan {{ mgmt_vlan }}
 name {{ mgmt_vlan_name | default('MGMT', true) }}
!
{%- for port in uplink_ports.split(',') %}
interface {{ port | trim }}
 description UPLINK
 switchport mode trunk
 switchport trunk native vlan {{ native_vlan | default(1, true) }}
{%- if allowed_vlans and allowed_vlans | lower != 'all' %}
 switchport trunk allowed vlan {{ allowed_vlans }}
{%- endif %}
 no shutdown
!
{%- endfor %}
interface Vlan{{ mgmt_vlan }}
 description Management
 ip address {{ mgmt_ip }} {{ mgmt_mask }}
 no shutdown
!
{%- if l3_switch | string | lower == 'true' %}
ip routing
ip route 0.0.0.0 0.0.0.0 {{ mgmt_gateway }}
{%- else %}
ip default-gateway {{ mgmt_gateway }}
{%- endif %}
!
ip ssh version 2
ip ssh source-interface Vlan{{ mgmt_vlan }}
!
